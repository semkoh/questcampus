{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "questcampus-auth",
    "Audience": "questcampus",
    "SigningKey": "dev-only-signing-key-change-me-0123456789abcdef"
  },
  "Services": {
    "AuthApi": "http://localhost:5001",
    "QuestsApi": "http://localhost:5002"
  },
  "ReverseProxy": {
    "Routes": {
      "questsRoute": {
        "ClusterId": "questsCluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/quests/{**catch-all}" }
      },
      "teamsRoute": {
        "ClusterId": "questsCluster",
        "AuthorizationPolicy": "default",
        "Match": { "Path": "/api/teams/{**catch-all}" }
      }
    },
    "Clusters": {
      "questsCluster": {
        "Destinations": {
          "questsApi": { "Address": "http://localhost:5002/" }
        }
      }
    }
  }
}
