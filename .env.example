# Copier ce fichier en .env puis adapter les valeurs (docker compose le lit automatiquement).

# Clé HMAC de signature des JWT, partagée par l'API Auth, le BFF et l'API Métier (32 caractères minimum).
# Générer par exemple avec : openssl rand -base64 48
JWT_SIGNING_KEY=change-me-with-a-long-random-secret-of-at-least-32-chars

# Mots de passe des deux bases PostgreSQL (une par service).
AUTH_DB_PASSWORD=auth_dev_password
QUESTS_DB_PASSWORD=quests_dev_password

# Port local de l'application web.
WEB_PORT=8080

# true = sélecteur de position simulée dans le front (démo en salle).
DEMO_MODE=true
